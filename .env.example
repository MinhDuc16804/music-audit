# Chép file này thành .env rồi điền giá trị. Không gửi khóa qua chat, không đưa .env vào git.

# Dịch vụ cho submit và fetch: audd hoặc acrcloud. Để trống thì theo khóa đang có, giống lệnh identify
MUSIC_SERVICE=

# Khóa API của AudD, dùng cho lệnh identify, identify-file và submit
AUDD_API_TOKEN=

# Số đoạn 12 giây tối đa AudD quét cho mỗi video. Để trống là 300, tức 1 giờ
AUDD_MAX_CHUNKS=

# Access Token tạo trong console ACRCloud. Nếu điền, lệnh identify sẽ dùng ACRCloud thay vì AudD
ACRCLOUD_ACCESS_TOKEN=

# API key của YouTube Data API, dùng cho lệnh list-videos và để biết độ dài video khi quét bằng link
YOUTUBE_API_KEY=

# Đường dẫn tới ffmpeg, dùng khi tách mp3 từ link YouTube. Để trống nếu ffmpeg đã có trong PATH
FFMPEG_LOCATION=

# Trần số yêu cầu AudD cho mỗi lần quét cả kênh trên web app. Vượt trần thì không gửi được. Để trống là 5000
# Nên đặt khoảng 1/4 số yêu cầu của ngân sách tháng, để một lần quét không dùng hết cả tháng
MAX_CHANNEL_SCAN_REQUESTS=10000

# Trần chi phí AudD mỗi tháng cho cả app, tính theo tháng lịch giờ Việt Nam. Đây là giới hạn duy nhất, app không giới hạn theo ngày.
# Để trống thì tắt. Đã điền mà sai, thiếu giá, hoặc thấp hơn phí gói thì app chặn mọi lượt quét tới khi sửa.
# Ví dụ gói 5 USD: 200 khi quét video tồn đọng (khoảng 39.000 yêu cầu), 20 khi chỉ quét video mới (4.000 yêu cầu)
AUDD_MONTHLY_BUDGET=20
# Gói AudD đang dùng: phí gói mỗi tháng, số yêu cầu đã gồm trong phí gói, giá cho 1.000 yêu cầu vượt gói
# Gói 5 USD: 5, 1000, 5. Gói 450 USD: 450, 100000, 4.5. Gói 850 USD: 850, 200000, 4.25
AUDD_PLAN_FEE=5
AUDD_PLAN_REQUESTS=1000
AUDD_PRICE_PER_1000=5
# Đơn vị tiền hiển thị. Để trống là USD
AUDD_BUDGET_CURRENCY=
# Hiện cảnh báo khi đã dùng tới bao nhiêu phần trăm. Để trống là 80
AUDD_BUDGET_WARN_PERCENT=

# Xác minh người dùng qua Cloudflare Access. Điền cả hai thì yêu cầu không có token Access hợp lệ bị từ chối
# Ví dụ ten-cong-ty.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) Tag trong trang ứng dụng của Cloudflare Access
CF_ACCESS_AUD=
