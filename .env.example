# Chép file này thành .env rồi điền giá trị. Không gửi khóa qua chat, không đưa .env vào git.

# Khóa API của AudD, dùng cho lệnh identify và identify-file
AUDD_API_TOKEN=

# Số đoạn 12 giây tối đa AudD quét cho mỗi video. Để trống là 300, tức 1 giờ
AUDD_MAX_CHUNKS=

# Access Token tạo trong console ACRCloud. Nếu điền, lệnh identify sẽ dùng ACRCloud thay vì AudD
ACRCLOUD_ACCESS_TOKEN=

# API key của YouTube Data API, dùng cho lệnh list-videos và để biết độ dài video khi quét bằng link
YOUTUBE_API_KEY=

# Đường dẫn tới ffmpeg, dùng khi tách mp3 từ link YouTube. Để trống nếu ffmpeg đã có trong PATH
FFMPEG_LOCATION=

# Số lượt quét mỗi người mỗi ngày của web app, để cả công ty dùng chung khóa AudD không tốn quá mức.
MAX_SCANS_PER_USER_PER_DAY=30
